# ---------------------------------------------------------------
# App
# ---------------------------------------------------------------
# Public base URL of this app. Used for MoonPay redirectURL and recipient links.
# Must be HTTPS in any environment MoonPay redirects to (use an ngrok/Vercel URL for local testing).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------
# Supabase (Project Settings -> API)
# ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------
# MoonPay (Dashboard -> Developers)
# ---------------------------------------------------------------
# "sandbox" uses pk_test_/sk_test_/wk_test_ keys and sell-sandbox.moonpay.com.
# "production" uses pk_live_/sk_live_/wk_live_ keys and sell.moonpay.com.
MOONPAY_ENV=sandbox
MOONPAY_PUBLISHABLE_KEY=pk_test_xxx
# Server-only: signs widget URLs and authenticates REST calls.
MOONPAY_SECRET_KEY=sk_test_xxx
# Server-only: verifies the Moonpay-Signature-V2 header on webhooks.
MOONPAY_WEBHOOK_KEY=wk_test_xxx
# Payout method requested in quotes / preselected in the sell widget.
# "credit_debit_card" is MoonPay's card payout (Visa Direct where supported).
MOONPAY_PAYOUT_METHOD=credit_debit_card

# ---------------------------------------------------------------
# Avec Pay fee (kept separate from MoonPay's fees)
# ---------------------------------------------------------------
# Percentage of the sell amount. 0 disables the fee.
AVECPAY_FEE_PERCENT=0
# How the fee is collected. "moonpay_partner_fee" passes it to MoonPay as
# extraFeePercentage so MoonPay deducts and settles it to Avec Pay (Avec Pay never
# touches customer funds). This must be enabled on your MoonPay account.
AVECPAY_FEE_COLLECTION=moonpay_partner_fee

# ---------------------------------------------------------------
# Wallet connection (optional)
# ---------------------------------------------------------------
# Free project ID from https://cloud.reown.com (WalletConnect). Public, not a
# secret. Enables "Connect wallet" for Ethereum-style networks. Tron uses the
# TronLink wallet directly and needs no ID. Without it, copy-paste still works.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# ---------------------------------------------------------------
# Stripe (Avec's own account)
# ---------------------------------------------------------------
# Server-only. Restricted key permissions needed (Write): Checkout Sessions,
# Products, Prices, Customers, Subscriptions, Coupons, Customer portal,
# Accounts, Account Links (Connect). Or a standard secret key.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint <site>/api/webhooks/stripe for
# events on Avec's account: checkout.session.completed,
# checkout.session.async_payment_succeeded, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted,
# invoice.paid, invoice.payment_failed.
STRIPE_WEBHOOK_SECRET=
# Signing secret of a second endpoint (same URL) for "Connected accounts":
# checkout.session.completed, checkout.session.async_payment_succeeded,
# account.updated.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Legacy: this Avec user's shop takes cards on the account above without
# connecting. Also an admin. Leave empty once your shop uses Connect.
AVEC_STRIPE_OWNER_EMAIL=
# Avec's fee on card payments in basis points (50 = 0.5%). Never on tips.
AVEC_PLATFORM_FEE_BPS=50

# ---------------------------------------------------------------
# Avec admin, email, AI, cron
# ---------------------------------------------------------------
# Comma-separated emails that can open /admin (codes, launch pricing).
AVEC_ADMIN_EMAILS=
# Resend (same account as Supabase SMTP). Sends invites, reminders, reports.
RESEND_API_KEY=
EMAIL_FROM="Avec Pay <no-reply@yourdomain.com>"
# Anthropic API key for AI reports (Business plan). Off when empty.
ANTHROPIC_API_KEY=
# Vercel Cron sends this as a Bearer token to /api/cron/daily.
CRON_SECRET=
# Business time zone for dates and reports.
NEXT_PUBLIC_AVEC_TIMEZONE=America/New_York
# Shown on the Terms and Privacy pages.
NEXT_PUBLIC_SUPPORT_EMAIL=
